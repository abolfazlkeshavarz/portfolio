# This repo is authored on Windows and deployed on Linux. Shell scripts, the
# Makefile and nginx configs must arrive with LF endings — a CRLF shebang
# fails on the server with a bare "bad interpreter: /usr/bin/env bash^M", and
# make treats trailing CRs as part of the command.
* text=auto eol=lf

*.sh            text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.template      text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff2 binary
*.tar.gz binary
