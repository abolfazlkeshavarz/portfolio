# Copy to .env with `make setup` (or ./scripts/setup-env.sh), then edit.

# Public hostname whose A record points at this server.
DOMAIN=abolfazlkeshavarz.com

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=abolfazlkeshavarz1112@gmail.com

# Loopback port this project's container publishes. Must be unique per
# project on a shared server; bootstrap-vps.sh picks a free one automatically.
APP_HTTP_PORT=8093

# Set to true to issue an untrusted staging certificate while testing the
# deploy, so failed attempts don't burn Let's Encrypt's rate limit.
LETSENCRYPT_STAGING=false

# Image tag used by docker-compose.yml.
IMAGE_TAG=latest
